---
// As 7 seções da documentação como cartas do jogo (D-079). Dados: src/docs-map.mjs.
import { DOCS, SECOES, numero } from '../docs-map.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="secoes not-content" aria-labelledby="secoes-titulo">
	<div class="bloco-cabecalho">
		<h2 id="secoes-titulo">O projeto em sete partes</h2>
		<p>{DOCS.length} documentos, do porquê ao como.</p>
	</div>
	<div class="cartas">
		{
			SECOES.map(({ nome, resumo }) => (
				<article class="carta">
					<h3>{nome}</h3>
					<p>{resumo}</p>
					<ul>
						{DOCS.filter((doc) => doc.secao === nome).map((doc) => (
							<li>
								<a href={`${base}/${doc.slug}/`}>
									<span class="num">{numero(doc)}</span>
									<span class="nome">{doc.curto}</span>
									{doc.incompleto && <span class="tag">incompleto</span>}
								</a>
							</li>
						))}
					</ul>
				</article>
			))
		}
	</div>
</section>
